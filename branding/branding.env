# Einzige Quelle für den Namen. Kein Skript, keine Datei, kein Design darf den Namen fest eintragen.
# Ein Namenswechsel soll nur diese Datei ändern müssen.
ORBIS_PROJECT_NAME="Project Orbis"
ORBIS_OS_NAME="Orbis"
ORBIS_OS_ID="orbis"
ORBIS_VENDOR="Project Orbis"
# Status des Namens: Arbeitsname, Markenrecherche vor der öffentlichen Veröffentlichung nötig.
ORBIS_NAME_STATUS="arbeitsname"
# Sichtbare Ausgabe-Bezeichnung (z. B. KDE "Über dieses System"). Bis zur ersten Beta: Prototyp.
ORBIS_EDITION="Prototyp"
