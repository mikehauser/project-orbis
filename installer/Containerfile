# Project Orbis – Umgebung der Live-ISO (Ausprobieren und Installieren)
#
# Abgeleitet von ublue-os/bazzite, Ordner installer/ (Apache-2.0), siehe NOTICE.
# Die ISO selbst baut danach Titanoboa (ublue-os/titanoboa) aus diesem Image.
#
# Bauen nur über .github/workflows/build-iso.yml oder von Hand auf Linux, mit
# Repository-Wurzel als Kontext:
#   podman build --cap-add sys_admin --security-opt label=disable \
#     --build-arg BASE_IMAGE=<image> --build-arg INSTALL_IMAGE_PAYLOAD=<image> \
#     -f installer/Containerfile .
#
# BASE_IMAGE          = Image, das in der Live-Sitzung läuft (bei uns: das Orbis-Image)
# INSTALL_IMAGE_PAYLOAD = Image, das auf die Festplatte installiert wird (Orbis-Image)

ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD

FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD
RUN --mount=type=bind,source=.,target=/src \
    env \
    BASE_IMAGE="${BASE_IMAGE}" \
    INSTALL_IMAGE_PAYLOAD="${INSTALL_IMAGE_PAYLOAD}" \
    FLATPAK_DIR_SHORTNAME="kde_flatpaks" \
    /src/installer/build.sh
