# Parameter für den Image-Build (gelesen vom Justfile).
# Der sichtbare Produktname steht NICHT hier, sondern nur in branding/branding.env.
# IMAGE_NAME muss klein geschrieben sein und ist der Name im Container-Register (hier: Repository-Name).

IMAGE_NAME=project-orbis
REPO_ORGANIZATION="mikehauser"
IMAGE_DESC="Orbis, Gaming- und Multimedia-Betriebssystem (Prototyp, Project Orbis)"
IMAGE_KEYWORDS="bootc,oci,linux,gaming,bazzite"
IMAGE_LOGO_URL=""
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
